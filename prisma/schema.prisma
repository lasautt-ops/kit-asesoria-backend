generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  SUPERADMIN
  ADMIN
  DIRECTOR
  TRABAJADOR
  CLIENTE
}

model Empresa {
  id        String   @id @default(cuid())
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oficinas     Oficina[]
  trabajadores Trabajador[]
  clientes     Cliente[]
  usuarios     Usuario[]
}

model Oficina {
  id        String   @id @default(cuid())
  nombre    String
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  usuarios      Usuario[]
  trabajadores  Trabajador[]
  clientes      Cliente[]

  @@index([empresaId])
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  oficinaId String?
  oficina   Oficina? @relation(fields: [oficinaId], references: [id], onDelete: SetNull)

  trabajador Trabajador?
  cliente    Cliente?
  documentosSubidos Documento[]

  @@index([empresaId])
  @@index([oficinaId])
  @@index([rol])
}

model Trabajador {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  oficinaId String
  oficina   Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  clientes Cliente[]

}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  oficinaId String
  oficina   Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  trabajadorId String?
  trabajador   Trabajador? @relation(fields: [trabajadorId], references: [id], onDelete: SetNull)

  documentos Documento[]

  @@index([trabajadorId])
}

model Documento {
  id        String   @id @default(cuid())
  nombre    String
  nombreArchivo String
  tipo      String
  estado    EstadoDocumento @default(PENDIENTE)
  rutaArchivo String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  subidoPorUsuarioId String
  subidoPorUsuario   Usuario @relation(fields: [subidoPorUsuarioId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([subidoPorUsuarioId])
  @@index([estado])
}

enum EstadoDocumento {
  PENDIENTE
  RECIBIDO
  EN_REVISION
  CORRECTO
  FALTA_INFORMACION
}

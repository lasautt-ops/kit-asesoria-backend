generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Rol {
  SUPERADMIN
  ADMIN
  DIRECTOR
  TRABAJADOR
  CLIENTE
}

enum TipoAviso {
  GENERAL
  DOCUMENTACION
  IMPORTANTE
  PLAZO
  INFORMACION
}

enum PrioridadAviso {
  NORMAL
  ALTA
  URGENTE
}

enum EstadoAviso {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

model Empresa {
  id                    String   @id @default(cuid())
  nombre                String
  cif                   String?
  direccion             String?
  codigoPostal          String?
  poblacion             String?
  provincia             String?
  nombreAdministrador   String?
  emailAdministrador    String?
  telefonoAdministrador String?
  web                   String?
  notas                 String?
  activo                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  oficinas             Oficina[]
  trabajadores         Trabajador[]
  clientes             Cliente[]
  usuarios             Usuario[]
  tareas               Tarea[]
  avisos               Aviso[]
  eventosCalendario    EventoCalendario[]
}

model Oficina {
  id        String   @id @default(cuid())
  nombre    String

  direccion          String?
  codigoPostal       String?
  poblacion          String?
  provincia          String?
  telefono           String?
  email              String?
  responsable        String?
  notas              String?

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  usuarios      Usuario[]
  trabajadores  Trabajador[]
  clientes      Cliente[]

  @@index([empresaId])

  tareas Tarea[]
  eventosCalendario EventoCalendario[]
}

model Usuario {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  password  String
  rol       Rol
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String?
  empresa   Empresa? @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  oficinaId String?
  oficina   Oficina? @relation(fields: [oficinaId], references: [id], onDelete: SetNull)

  trabajador Trabajador?
  cliente    Cliente?
  documentosSubidos Documento[]

  @@index([empresaId])
  @@index([oficinaId])
  @@index([rol])

  tareasAsignadas Tarea[] @relation("TareasAsignadas")
  tareasCreadas   Tarea[] @relation("TareasCreadas")

  avisosCreados Aviso[] @relation("AvisosCreados")
  eventosCalendarioCreados EventoCalendario[]
}

model Trabajador {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  oficinaId String
  oficina   Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  clientes Cliente[]

}

model Cliente {
  id        String   @id @default(cuid())
  nombre    String
  email     String
  telefono  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarioId String?  @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  oficinaId String
  oficina   Oficina @relation(fields: [oficinaId], references: [id], onDelete: Cascade)

  trabajadorId String?
  trabajador   Trabajador? @relation(fields: [trabajadorId], references: [id], onDelete: SetNull)

  documentos Documento[]

  @@index([trabajadorId])

  tareas Tarea[]
  avisos AvisoCliente[]
  eventosCalendario EventoCalendario[]
}

model Documento {
  id        String   @id @default(cuid())
  nombre    String
  nombreArchivo String
  tipo      String
  estado    EstadoDocumento @default(PENDIENTE)
  rutaArchivo String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  subidoPorUsuarioId String
  subidoPorUsuario   Usuario @relation(fields: [subidoPorUsuarioId], references: [id], onDelete: Restrict)

  @@index([clienteId])
  @@index([subidoPorUsuarioId])
  @@index([estado])
}

enum EstadoDocumento {
  PENDIENTE
  RECIBIDO
  EN_REVISION
  CORRECTO
  FALTA_INFORMACION
}

model Tarea {
  id                  String    @id @default(cuid())
  titulo              String
  descripcion         String?
  estado              EstadoTarea @default(PENDIENTE)
  prioridad            PrioridadTarea @default(MEDIA)
  fechaLimite         DateTime?

  empresaId           String
  oficinaId           String?
  clienteId           String?
  asignadoAUsuarioId  String?
  creadoPorUsuarioId  String

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  empresa             Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  oficina             Oficina?  @relation(fields: [oficinaId], references: [id], onDelete: SetNull)
  cliente             Cliente?  @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  asignadoAUsuario    Usuario?  @relation("TareasAsignadas", fields: [asignadoAUsuarioId], references: [id], onDelete: SetNull)
  creadoPorUsuario    Usuario   @relation("TareasCreadas", fields: [creadoPorUsuarioId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@index([oficinaId])
  @@index([clienteId])
  @@index([asignadoAUsuarioId])
  @@index([creadoPorUsuarioId])
}

enum EstadoTarea {
  PENDIENTE
  EN_PROCESO
  COMPLETADA
  CANCELADA
}

enum PrioridadTarea {
  BAJA
  MEDIA
  ALTA
}

model Aviso {
  id               String          @id @default(cuid())
  titulo           String
  contenido        String
  tipo             TipoAviso       @default(GENERAL)
  prioridad        PrioridadAviso  @default(NORMAL)
  estado           EstadoAviso     @default(BORRADOR)

  tipoDestinatario TipoDestinatario @default(CLIENTES)

  fechaPublicacion DateTime?
  fechaCaducidad   DateTime?

  empresaId        String
  creadoPorUsuarioId String

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  empresa          Empresa         @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  creadoPorUsuario Usuario         @relation("AvisosCreados", fields: [creadoPorUsuarioId], references: [id], onDelete: Restrict)

  destinatarios    AvisoCliente[]

  @@index([empresaId])
  @@index([creadoPorUsuarioId])
  @@index([estado])
  @@index([fechaPublicacion])
  @@index([fechaCaducidad])
}

model AvisoCliente {
  id            String    @id @default(cuid())

  avisoId       String
  clienteId     String

  leido         Boolean   @default(false)
  fechaLectura  DateTime?

  createdAt     DateTime  @default(now())

  aviso         Aviso     @relation(fields: [avisoId], references: [id], onDelete: Cascade)
  cliente       Cliente   @relation(fields: [clienteId], references: [id], onDelete: Cascade)

  @@unique([avisoId, clienteId])
  @@index([avisoId])
  @@index([clienteId])
  @@index([clienteId, leido])
}

enum TipoDestinatario {
  TODOS
  CLIENTES
}

model EventoCalendario {
  id                String                  @id @default(cuid())
  titulo            String
  descripcion       String?
  tipo              TipoEventoCalendario    @default(OTRO)
  fechaInicio       DateTime
  fechaFin          DateTime
  todoElDia         Boolean                 @default(false)
  ubicacion         String?
  estado            EstadoEventoCalendario  @default(PROGRAMADO)

  empresaId         String
  oficinaId         String?
  clienteId         String?
  creadoPorUsuarioId String

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  empresa           Empresa                 @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  oficina           Oficina?                @relation(fields: [oficinaId], references: [id], onDelete: SetNull)
  cliente           Cliente?                @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  creadoPorUsuario  Usuario                 @relation(fields: [creadoPorUsuarioId], references: [id], onDelete: Restrict)

  @@index([empresaId])
  @@index([oficinaId])
  @@index([clienteId])
  @@index([creadoPorUsuarioId])
  @@index([fechaInicio])
  @@index([estado])
}

enum TipoEventoCalendario {
  CITA
  REUNION
  VENCIMIENTO
  TAREA_PROGRAMADA
  RECORDATORIO
  OTRO
}

enum EstadoEventoCalendario {
  PROGRAMADO
  COMPLETADO
  CANCELADO
}
